{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mygame-backend",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/health",
      "/render-test",
      "/hello",
      "/register",
      "/income/pages/login/reset/"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "30 18 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
