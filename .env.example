PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret

# WatchPay
WATCHPAY_BASE_URL=https://api.watch-glb.com
WATCHPAY_PAY_PATH=/pay/web
WATCHPAY_MCH_ID=replace_with_merchant_id
WATCHPAY_KEY=replace_with_watchpay_key
WATCHPAY_SIGN_TYPE=MD5
WATCHPAY_PAY_TYPE=101
WATCHPAY_SEND_VERSION=1
WATCHPAY_SUCCESS_RESULTS=1,success,SUCCESS,SUCCESSFUL
WATCHPAY_GOODS_NAME=MyGame Recharge
WATCHPAY_NOTIFY_URL=https://mygame-backend.de.deplexo.com/api/payment-gateway/webhook
WATCHPAY_RETURN_URL=https://mygame-backend.de.deplexo.com/payment-success.html
# Optional:
# WATCHPAY_PAGE_URL=
# WATCHPAY_RETURN_MSG=
PUBLIC_BASE_URL=https://mygame-backend.de.deplexo.com
